# ============================================================
# MẪU CẤU HÌNH — sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env (đã được .gitignore loại trừ).
# ============================================================

# ---- Nhà cung cấp LLM mặc định: openrouter | groq | gemini ----
DEFAULT_LLM_PROVIDER=gemini

# ---- Google AI Studio (Gemini / Gemma) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=2048

# ---- OpenRouter (tùy chọn) ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ---- Groq (tùy chọn) ----
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

# ---- Supabase (nguồn dữ liệu điểm) ----
# SUPABASE_KEY PHẢI là service_role key (chỉ dùng ở backend, KHÔNG lộ ra trình duyệt).
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=
# Để trống = nạp TẤT CẢ các môn; điền tên 1 môn = chỉ nạp môn đó.
SUPABASE_SUBJECT_NAME=

# ---- Chế độ đăng nhập/phân quyền: select (demo chọn vai trò) | login (Supabase Auth) ----
AUTH_MODE=select

# ---- Bộ nhớ hội thoại ngắn hạn ----
SHORT_TERM_MAX_TURNS=10

# ---- Giao diện ----
APP_TITLE=Tra Cứu Điểm Học Sinh
APP_ICON=📚
APP_DESCRIPTION=

# ---- Log ----
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ---- Langfuse (observability, tùy chọn) ----
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=false
